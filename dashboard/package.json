{
  "name": "itglobal-dashboard-frontend",
  "version": "1.0.0",
  "description": "Modern frontend build system for IT Global Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "npm run lint && npm run build && npm run verify-manifest",
    "deploy": "npm run build:prod && npm run deploy:flask",
    "deploy:safe": "npm run backup:manifest && npm run deploy || npm run rollback:manifest",
    "verify-manifest": "node scripts/verify-manifest.js",
    "deploy:flask": "node scripts/deploy-flask.js",
    "backup:manifest": "node scripts/backup-manifest.js",
    "rollback:manifest": "node scripts/rollback-manifest.js",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts,.vue --fix",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.3.1",
    "autoprefixer": "^10.4.17",
    "cssnano": "^6.0.3",
    "eslint": "^8.56.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "sass": "^1.70.0",
    "vite": "^5.1.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.0",
    "choices.js": "^11.1.0",
    "datatables.net": "^2.3.4",
    "datatables.net-bs5": "^2.3.4",
    "tom-select": "^2.4.3"
  }
}
