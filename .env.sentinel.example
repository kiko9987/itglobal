# Redis Sentinel 고가용성 설정 예시
# docker-compose.sentinel.yml과 함께 사용

# Sentinel 모드 활성화
REDIS_USE_SENTINEL=true

# Sentinel 호스트 목록 (쉼표로 구분)
REDIS_SENTINEL_HOSTS=localhost:26379,localhost:26380,localhost:26381

# Master 이름 (redis-sentinel.conf와 일치해야 함)
REDIS_MASTER_NAME=mymaster

# Redis 비밀번호 (선택사항)
REDIS_PASSWORD=

# Redis DB 번호
REDIS_DB=0

# 타임아웃 설정 (초)
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ===== 기존 단일 인스턴스 모드 설정 =====
# REDIS_USE_SENTINEL=false 또는 미설정 시 사용

# Redis 호스트 및 포트
# REDIS_HOST=localhost
# REDIS_PORT=6379
