# ================================
# IT Global Dashboard 환경 변수 예시
# ================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# cp .env.example .env

# ================================
# Flask 기본 설정
# ================================
FLASK_ENV=development                    # development, production, testing
FLASK_DEBUG=True                         # True/False
PORT=5000                                # Flask 서버 포트
SECRET_KEY=your-secret-key-here          # 세션 암호화 키 (프로덕션에서는 강력한 랜덤 값 사용)

# ================================
# 세션 및 보안 설정
# ================================
SESSION_TIMEOUT_HOURS=4                  # 세션 타임아웃 시간 (권장: 2-4시간)
LOCK_TIMEOUT_MINUTES=5                   # 편집 잠금 타임아웃 (권장: 5-10분)

# ================================
# Google Sheets API 설정
# ================================
GOOGLE_SHEET_ID=your-google-sheet-id-here                      # Google Sheets 문서 ID
GOOGLE_SHEET_NAME=공사 현황의 사본                               # 시트 이름
GOOGLE_APPLICATION_CREDENTIALS=credentials.json                 # 서비스 계정 JSON 파일 경로
# 또는
GOOGLE_CREDENTIALS_FILE=credentials.json                        # 대체 환경 변수명

# ================================
# Google OAuth 2.0 설정
# ================================
# ⚠️ 보안 주의: Client ID/Secret은 .env에 직접 저장하지 마세요!
# dashboard/google_oauth_credentials.json 파일에 저장하는 것을 권장합니다
# 코드가 자동으로 google_oauth_credentials.json 파일을 우선 사용합니다
#
# 파일 생성 방법:
# 1. Google Cloud Console → API 및 서비스 → 사용자 인증 정보
# 2. OAuth 2.0 클라이언트 ID 생성 (웹 애플리케이션)
# 3. JSON 다운로드 → dashboard/google_oauth_credentials.json으로 저장
#
# .env에 저장하는 방법 (권장하지 않음):
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here
GOOGLE_OAUTH_ALLOWED_DOMAIN=itg-aircon.com                      # 허용된 도메인 (예: company.com)
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:5000/auth/callback  # 콤마로 구분된 리다이렉트 URI 목록
GOOGLE_OAUTH_DEFAULT_REDIRECT_URI=http://localhost:5000/auth/callback

# ================================
# Google Calendar 연동 설정
# ================================
# OAuth 클라이언트 시크릿 파일 경로
GOOGLE_CALENDAR_CLIENT_SECRET_FILE=dashboard/google_calendar_client_secret.json

# Google Calendar ID (primary = 기본 캘린더, 또는 특정 캘린더 ID)
# 캘린더 ID는 Google Calendar 설정 > 특정 캘린더 설정 > "캘린더 통합" 섹션에서 확인 가능
GOOGLE_CALENDAR_ID=primary

# 토큰 파일 경로 (선택사항, 기본값: instance/google_calendar_token.json)
# GOOGLE_CALENDAR_TOKEN_FILE=instance/google_calendar_token.json

# ================================
# 로깅 설정
# ================================
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR, CRITICAL
DEBUG=False                              # 디버그 모드 (True/False)
LOG_MAX_BYTES=10485760                   # 로그 파일 최대 크기 (바이트, 기본: 10MB)
LOG_BACKUP_COUNT=5                       # 로그 파일 백업 개수

# ================================
# 캐시 설정
# ================================
CACHE_TTL_CRITICAL=60                    # 중요 데이터 캐시 TTL (초, 기본: 60초)
CACHE_TTL_STATIC=3600                    # 정적 데이터 캐시 TTL (초, 기본: 1시간)

# ================================
# Redis 설정
# ================================
REDIS_HOST=localhost                     # Redis 서버 호스트
REDIS_PORT=6379                          # Redis 서버 포트
REDIS_DB=0                               # Redis 데이터베이스 번호 (0-15)
REDIS_PASSWORD=                          # Redis 비밀번호 (선택사항)
REDIS_SOCKET_TIMEOUT=5                   # Socket 타임아웃 (초)
REDIS_SOCKET_CONNECT_TIMEOUT=5           # 연결 타임아웃 (초)

# ================================
# 알림 시스템 (선택)
# ================================
# 이메일 알림 설정
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-email-password-or-app-password
ADMIN_EMAILS=admin1@company.com,admin2@company.com  # 콤마로 구분

# Slack 알림 설정
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# 알림 설정
NOTIFICATION_INTERVAL_HOURS=24           # 알림 전송 간격 (시간)
MISSING_FIELDS_THRESHOLD=3               # 필수 필드 누락 임계값

# ================================
# 에러 추적 (선택)
# ================================
# Sentry DSN (프로덕션 환경에서 사용)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ================================
# 데이터베이스 (SQLite - 자동 생성)
# ================================
# DATABASE_PATH는 자동으로 instance/projects.db로 설정됨
# 별도 설정 불필요

# ================================
# 개발 환경 전용 설정
# ================================
# CALLBACK_URL=http://localhost:5000                # OAuth 콜백 URL (개발용)

# ================================
# 프로덕션 환경 추가 설정
# ================================
# 프로덕션 배포 시 아래 설정 추가 권장
# SESSION_COOKIE_SECURE=True              # HTTPS 환경에서만 True로 설정
# PREFERRED_URL_SCHEME=https
# SERVER_NAME=your-domain.com

# ================================
# 주의사항
# ================================
# 1. .env 파일은 절대 Git에 커밋하지 마세요! (.gitignore에 포함되어 있음)
# 2. 프로덕션 환경에서는 SECRET_KEY를 강력한 랜덤 값으로 변경하세요
#    예: python -c "import secrets; print(secrets.token_hex(32))"
# 3. Google OAuth 설정은 Google Cloud Console에서 발급받으세요
# 4. credentials.json 파일은 Google Cloud Console에서 서비스 계정 키로 다운로드하세요
