# ================================
# ITG Aircon Dashboard 환경 변수 예시
# ================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
#   cp .env.example .env
#
# 2026-07-07 재작성: 활성 프로덕션 .env의 실제 구조·변수 반영
# 시크릿 값은 모두 placeholder — 실제 값으로 교체 후 사용
# .env는 절대 Git에 커밋 금지 (.gitignore로 제외됨)

# ================================
# Flask 기본 설정
# ================================
FLASK_ENV=development                    # development / production / testing
DEBUG=True                               # True / False
DEVELOPMENT_MODE=True                    # 개발 모드 플래그
HOST=0.0.0.0                             # Flask 서버 바인딩 주소
PORT=5000                                # Flask 서버 포트
SECRET_KEY=change-this-secret-key-to-random-string
FLASK_SECRET_KEY=change-this-flask-secret-key-to-random-string
# 재생성: python -c "import secrets; print(secrets.token_hex(32))"

# 프로덕션 배포 시 추가 권장:
# SESSION_COOKIE_SECURE=True              # HTTPS 환경에서만 True
# PREFERRED_URL_SCHEME=https
# SERVER_NAME=your-domain.com

# ================================
# Google OAuth (사용자 로그인)
# ================================
OAUTHLIB_INSECURE_TRANSPORT=1            # 개발용, HTTPS 아닐 때만 사용
SKIP_OAUTH=false                         # true면 로그인 검증 스킵 (개발용)

# ================================
# Google Sheets API - 프로젝트 관리
# ================================
GOOGLE_APPLICATION_CREDENTIALS=credentials.json    # 서비스 계정 JSON 파일 경로
GOOGLE_CREDENTIALS_FILE=credentials.json           # 대체 환경 변수명 (동일 파일)
GOOGLE_SHEET_ID=1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_SHEET_NAME=공사 현황
SHEET_RANGE=A:AP                         # 조회 범위 (2026-07 컬럼 시프트 반영, AP까지)

# ================================
# Google Sheets - 온라인 문의 리드 (별도 시트)
# ================================
ONLINE_LEADS_SHEET_ID=1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ONLINE_LEADS_SHEET_NAME=리드 관리         # 2026-07 변경: '고객 리드 관리' → '리드 관리'

# ================================
# 시트 컬럼 매핑 (코드에서 참조)
# ================================
# 2026-05-22 컬럼 시프트 (E열 사업자명 추가) 후의 최종 위치
PROJECT_CODE_COLUMN=A                    # 프로젝트 코드
OWNER_EMAIL_COLUMN=Q                     # 발주처 이메일
CREATED_DATE_COLUMN=AM                   # 공사 확정 (옛 AL → AM)
DEPOSIT_DATE_COLUMN=Z                    # 수금 날짜
CONFIRM_COLUMN=AA                        # 수금 확인 체크박스

# ================================
# Google Calendar 연동
# ================================
GOOGLE_CALENDAR_CLIENT_SECRET_FILE=dashboard/google_calendar_client_secret.json
GOOGLE_CALENDAR_ID=c_XXXXXXXXXXXXXXXXXXXXXXXXXXX@group.calendar.google.com
# 토큰은 첫 인증 시 자동 저장: instance/google_calendar_token.json
# 재인증: 브라우저로 http://localhost:5000/auth/google/calendar 접속

# ================================
# Google Drive (문서 폴더 · 방문사진)
# ================================
GOOGLE_DRIVE_VISIT_FOLDER_ID=1XXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_DRIVE_WINDOWS_BASE_PATH=G:\공유 드라이브\...\문의 견적서 모음
# BASE_PATH는 서버가 아닌 클라이언트 PC의 탐색기 경로 안내용 문자열
# 실제 파일 조작은 Google Drive API로 수행 (서버는 이 경로 접근 안 함)

# ================================
# 카카오 로컬 API (주소 검증)
# ================================
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# ================================
# 당근 자동 연동
# ================================
KARROT_AUTO_SHEET_ID=1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
KARROT_AUTO_SHEET_TAB=시트1
KARROT_SYNC_INTERVAL_MIN=2               # 폴링 주기 (분)
KARROT_BUSINESS_NUMBER=1234567890        # 당근 비즈니스 번호

# ================================
# 홈페이지 문의 메일 폴링 (Gmail API)
# ================================
HOMEPAGE_MAIL_USER=your-email@yourdomain.com
HOMEPAGE_MAIL_SYNC_INTERVAL_MIN=2        # 폴링 주기 (분)
HOMEPAGE_MAIL_DAYS_BACK=7                # 조회 기간 (일)
HOMEPAGE_PROCESSED_LABEL=processed       # 처리 완료 Gmail 라벨명

# ================================
# 채널톡 (고객 상담) 통합
# ================================
CHANNELTALK_ACCESS_KEY=your-channeltalk-access-key
CHANNELTALK_ACCESS_SECRET=your-channeltalk-access-secret
CHANNELTALK_OPERATOR_ID=your-channeltalk-operator-id

# ================================
# Slack - Bot Tokens (기능별 봇 4개)
# ================================
# Slack App 관리 → OAuth & Permissions → Bot User OAuth Token (xoxb-)
SLACK_BOT_ENABLED=true
SLACK_BOT_TOKEN=xoxb-YOUR-MAIN-BOT-TOKEN-HERE           # 기본 봇 (리드·관리자 알림·채널톡)
SLACK_PROJECT_BOT_TOKEN=xoxb-YOUR-PROJECT-BOT-TOKEN     # 공사 확정 카드 봇
SLACK_VISIT_BOT_TOKEN=xoxb-YOUR-VISIT-BOT-TOKEN         # 방문 관리 봇
SLACK_PAYMENT_BOT_TOKEN=xoxb-YOUR-PAYMENT-BOT-TOKEN     # 수금 관리 봇

# ================================
# Slack - Signing Secrets (이벤트 요청 검증용)
# ================================
# Slack App 관리 → Basic Information → App Credentials → Signing Secret (32자 hex)
SLACK_SIGNING_SECRET=your-signing-secret-32-hex-chars-000000000000
SLACK_PROJECT_SIGNING_SECRET=your-project-signing-secret-32-hex-000
SLACK_VISIT_SIGNING_SECRET=your-visit-signing-secret-32-hex-0000000
SLACK_PAYMENT_SIGNING_SECRET=your-payment-signing-secret-32-hex-000

# ================================
# Slack - Channel/User IDs
# ================================
# 채널 ID: 채널 이름 우클릭 → "채널 세부정보 보기" → 하단 채널 ID
# 사용자 ID(DM): 프로필 → 더보기 → 사용자 ID 복사
SLACK_ADMIN_CHANNEL=U0XXXXXXXXX          # 관리자 DM (사용자 ID)
SLACK_LEAD_CHANNEL=C0XXXXXXXXX           # 리드 인입 알림 채널
SLACK_PROJECT_CHANNEL=C0XXXXXXXXX        # 공사 확정 카드 채널
SLACK_VISIT_CHANNEL=C0XXXXXXXXX          # 방문 관리 채널
SLACK_PAYMENT_CHANNEL=C0XXXXXXXXX        # 수금 관리 채널 (정식 수금 카드)
SLACK_PAYMENT_INTAKE_CHANNEL=C0XXXXXXXXX # 수금 입력 채널 (은행 SMS 인입 카드 → 프로젝트 지정, 수금봇 초대 필요)
SLACK_INVOICE_CHANNEL_ID=C0XXXXXXXXX     # 세금계산서 요청 채널
SLACK_CHANNELTALK_CHANNEL=C0XXXXXXXXX    # 채널톡 알림 채널

# 방문 일정 캔버스 (봇이 전체 관리, 상태=방문 예약 lead 자동 렌더)
# 캔버스 URL 형식: https://<workspace>.slack.com/docs/<team_id>/<canvas_id>
# → canvas_id 부분 (F로 시작) 을 값으로
SLACK_VISIT_CANVAS_ID=F0XXXXXXXXX        # 방문 일정 캔버스 ID (봇 관리)
SLACK_VISIT_ASSIGNMENT_CANVAS_ID=F0XXXXXXXXX  # 방문 일정 조정 캔버스 (JW 파서 입력)

# ================================
# 은행 입금 SMS 인입 webhook (폰 SMS 포워딩 → /sms/inbound → #수금_입력 카드)
# ================================
# 폰별 비밀키 — 'device:secret' 콤마 구분. 폰 포워딩 앱이 JSON body 의 token 으로 전송.
#   안드로이드(SmsForwarder 등) / 아이폰(단축어 '메시지 받을 때' → URL POST).
#   한 대 유출 시 해당 항목만 교체하면 개별 폐기됨. secret 은 충분히 길게(예: openssl rand -hex 24).
SMS_INBOUND_TOKENS=jw:REPLACE_WITH_LONG_SECRET_1,yg:REPLACE_WITH_LONG_SECRET_2,ip:REPLACE_WITH_LONG_SECRET_3
# (선택) 허용 은행 발신번호 substring 콤마 목록. 설정 시 이 발신번호 문자만 통과.
#   비워두면 발신번호 검사 생략(폰 앱 필터 + '입금 X원' 패턴 검증에 의존).
SMS_BANK_SENDERS=

# ================================
# Slack - Workflow Builder 웹훅
# ================================
# Slack Workflow Builder → 워크플로 만들기 → 트리거 "Webhook" 선택 → 발급 URL 복사
# 형식: https://hooks.slack.com/triggers/T0.../A0.../.../...
SLACK_LIST_WEBHOOK_URL=https://hooks.slack.com/triggers/T0XXX/A0XXX/YOUR/SECRET
SLACK_LIST_UPDATE_WEBHOOK_URL=https://hooks.slack.com/triggers/T0XXX/A0XXX/YOUR/SECRET
SLACK_VISIT_CANCEL_WEBHOOK_URL=https://hooks.slack.com/triggers/T0XXX/A0XXX/YOUR/SECRET
SLACK_VISIT_COMPLETE_WEBHOOK_URL=https://hooks.slack.com/triggers/T0XXX/A0XXX/YOUR/SECRET
SLACK_VISIT_MODIFY_WEBHOOK_URL=https://hooks.slack.com/triggers/T0XXX/A0XXX/YOUR/SECRET
SLACK_VISIT_RESTORE_WEBHOOK_URL=https://hooks.slack.com/triggers/T0XXX/A0XXX/YOUR/SECRET

# ================================
# Slack - 이벤트 콜백 도메인
# ================================
SLACK_PUBLIC_HOST=your-domain.com        # 외부 공개 도메인 (http/https 접두어 없이)

# ================================
# 이메일 (Gmail SMTP)
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password         # Gmail App Password (2FA 필요)

# ================================
# 알림 시스템
# ================================
ADMIN_NOTIFY_EMAIL=admin@company.com
SALES_EMAILS=sales1@company.com,sales2@company.com    # 콤마 구분
NOTIFICATION_INTERVAL_HOURS=24
NOTIFY_SUPPRESS_MINUTES=30               # 같은 알림 재발송 방지 쿨다운
MISSING_FIELDS_THRESHOLD=3               # 필수 필드 누락 임계값

# ================================
# 스케줄러 · 폴링
# ================================
POLL_INTERVAL=300                        # 기본 폴링 주기 (초)
PHONE_WORKFLOW_SYNC_ENABLED=false        # 전화 리드 워크플로 sync 활성화
# 참고: sync_scheduler에는 이 외에도 자체 상수 주기가 있음
# (당근 2분·홈페이지 메일 2분·채널톡 1분·워크플로 전화 10초·수금 30초·재발송 5분)

# ================================
# 비즈니스 로직
# ================================
OVERDUE_CONFIRM_DAYS=30                  # 공사 확정 연체 기준일
REQUIRED_FIELDS=사업자,담당자,공사 시작   # 필수 필드 (콤마 구분)

# ================================
# 참고 - 코드 기본값으로 커버되는 옵션
# ================================
# 아래는 활성 .env에 없어도 코드가 기본값으로 동작.
# 필요 시에만 오버라이드.
#
# LOG_LEVEL=INFO                         # DEBUG / INFO / WARNING / ERROR
# LOG_MAX_BYTES=10485760                 # 로그 파일 최대 크기 (10MB)
# LOG_BACKUP_COUNT=5                     # 로그 백업 개수
# SESSION_TIMEOUT_HOURS=4                # 세션 타임아웃
# LOCK_TIMEOUT_MINUTES=5                 # 편집 잠금 타임아웃
# CACHE_TTL_CRITICAL=60                  # 중요 데이터 캐시 TTL (초)
# CACHE_TTL_STATIC=3600                  # 정적 데이터 캐시 TTL (초)
# REDIS_HOST=localhost                   # Redis 호스트 (기본: localhost)
# REDIS_PORT=6379                        # Redis 포트 (기본: 6379)
# REDIS_DB=0                             # Redis DB 번호
# REDIS_PASSWORD=                        # Redis 비밀번호 (없으면 빈 값)
# SENTRY_DSN=https://xxx@sentry.io/xxx   # 에러 추적 (프로덕션 권장)
# KARROT_MAX_NEW_PER_SYNC=5              # 안전망: sync당 최대 신규 리드 수

# ================================
# 이관 · 크레덴셜 파일 참조
# ================================
# .env 외에 별도 관리되는 크레덴셜 파일들:
# - credentials.json (Google Sheets 서비스 계정)
# - dashboard/google_calendar_client_secret.json (Calendar OAuth 클라이언트)
# - instance/google_calendar_token.json (Calendar refresh token, 자동 생성)
# - dashboard/google_oauth_credentials.json (사용자 로그인 OAuth)
# - instance/users.db (SQLite 사용자 DB)
# 이관 시 위 파일들과 이 .env 파일을 함께 이동
